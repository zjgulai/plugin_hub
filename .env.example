PLUGIN_HUB_DATABASE_URL=sqlite+pysqlite:///./plugin_hub.db
PLUGIN_HUB_COLLECTION_TASK_MAX_ATTEMPTS=3
PLUGIN_HUB_COLLECTION_TASK_RETRY_DELAY_SECONDS=300
PLUGIN_HUB_COLLECTION_TASK_CLAIM_TTL_SECONDS=900
PLUGIN_HUB_COLLECTION_TASK_WORKER_ID=api-worker

PLUGIN_HUB_REDDIT_CLIENT_ID=
PLUGIN_HUB_REDDIT_CLIENT_SECRET=
PLUGIN_HUB_REDDIT_USER_AGENT=PluginHubVOC/0.1 server-side capture

PLUGIN_HUB_INSTAGRAM_GRAPH_ACCESS_TOKEN=
PLUGIN_HUB_INSTAGRAM_GRAPH_LIVE_READ_ENABLED=false
PLUGIN_HUB_INSTAGRAM_GRAPH_API_VERSION=v25.0
PLUGIN_HUB_INSTAGRAM_GRAPH_API_BASE_URL=https://graph.facebook.com
PLUGIN_HUB_INSTAGRAM_GRAPH_COMMENT_LIMIT=50

PLUGIN_HUB_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8010","http://127.0.0.1:8010","https://plugin.lute-tlz-dddd.top"]
PLUGIN_HUB_CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://[a-z]{32}$

PLUGIN_HUB_API_URL=http://127.0.0.1:8000
PLUGIN_HUB_REFRESH_SECONDS=20
PLUGIN_HUB_SITE_ENV=local
PLUGIN_HUB_ENABLED_PLATFORMS=amazon,reddit,instagram
PLUGIN_HUB_LOW_CONFIDENCE_THRESHOLD=0.75
PLUGIN_HUB_AMAZON_PAGE_LIMIT=5
